{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "npa-traffic-accident-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Web アプリ（docs/DESIGN_WEB.md）。web/ で npm run build してから deploy する。
  // 開け閉めを Worker で決めるため、ファイルに当たるパスも先に Worker（src/route.ts）を通す
  "assets": { "directory": "../../web/dist", "binding": "ASSETS",
              "not_found_handling": "none", "run_worker_first": true },

  // "true" にすると Web アプリ（/web/mcp と画面）を開く。回数制限（DESIGN_WEB.md 7.1）が入るまでは閉じる
  // EVENT_UNTIL を過ぎると発表会用の入口 /e/<EVENT_PATH>/mcp を閉じる（README「発表会用の URL」）
  "vars": { "WEB_ENABLED": "false", "EVENT_UNTIL": "2026-10-22T23:59:59+09:00" },

  // server.py --http をそのままコンテナで動かす。Worker は転送するだけ。
  "containers": [
    {
      "class_name": "McpContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // lite(256MiB) では DuckDB が足りない見込み。basic = 1/4 vCPU, 1 GiB, 4 GB disk
      // 発表会当日だけ standard-2 に上げる（README「40人の同時利用」）
      "instance_type": "basic",
      // MCP セッションはコンテナのメモリ上にあるので、1台に寄せる
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MCP_CONTAINER", "class_name": "McpContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpContainer"] }]
}
